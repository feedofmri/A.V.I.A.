{
  "name": "@avia/server",
  "version": "0.1.0",
  "private": true,
  "description": "A.V.I.A. core API — Fastify + PostgreSQL (RLS)",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:prod": "node dist/db/seed.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
