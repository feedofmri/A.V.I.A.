# Where the Pulse "Open A.V.I.A. Cockpit" link points
VITE_COCKPIT_URL=http://localhost:5173
# Leave empty in dev (Vite proxies /api -> API_URL). Set a full URL only if you are NOT using the proxy.
VITE_API_BASE=
# Dev proxy target (default: the BFF on :4000) is set in the shell, not here:  API_URL=http://localhost:4000 npm run dev
