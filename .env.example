# Copy to .env — docker compose reads it automatically. All values have dev defaults.

# PostgreSQL superuser (runs migrations/init only)
POSTGRES_DB=avia
POSTGRES_USER=avia_admin
POSTGRES_PASSWORD=avia_admin_dev

# Non-superuser the API connects as, so Row Level Security is enforced.
# Created by docker/postgres/init/01-init.sh (or by `npm run db:migrate` if missing).
APP_DB_USER=avia_app
APP_DB_PASSWORD=avia_app_dev

# Host ports
POSTGRES_PORT=5432
REDIS_PORT=6379
SERVER_PORT=3000
BFF_PORT=4000
COCKPIT_PORT=8080
PULSE_PORT=8081
AGENT_PORT=8000

# Inference service (agent/): CPU threads for PyTorch
TORCH_THREADS=2

# BFF cache TTL (seconds)
CACHE_TTL_SECONDS=15

# Local software demonstration. Change these before any shared deployment.
DEMO_MODE=true
# DEMO_MODE=false requires AUTH_USERS JSON with operator and crew accounts.
# AUTH_USERS={"operator":{"password":"replace-with-long-secret","role":"operator"},"brandt":{"password":"replace-with-different-secret","role":"crew","crew":"brandt"}}
INTERNAL_API_TOKEN=avia-internal-local-demo-change-before-sharing
JOURNAL_KEY=avia-local-demo-journal-key-change-before-sharing
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081
# Optional cloud explanations (local inference works without these).
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
